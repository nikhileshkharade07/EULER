# Server-only OpenAI credential. Never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase public project configuration (safe for browser when RLS is correct).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do not expose this value to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Local executor is deliberately disabled unless explicitly configured.
EULER_LOCAL_EXECUTOR_ENABLED=false
EULER_ALLOWED_ORIGINS=http://localhost:3000
